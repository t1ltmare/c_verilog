module top_module (
  clk,
  sclk,
  lrck,
  i2s1_data,
  i2s2_data,
  pcm_data,
  i2s1_data_out,
  i2s2_data_out,
  red,
  green,
  blue
)
;
input clk;
output sclk;
output lrck;
output i2s1_data;
output i2s2_data;
output pcm_data;
output i2s1_data_out;
output i2s2_data_out;
output red;
output green;
output blue;
wire clk_d;
wire sclk_d;
wire lrck_d;
wire i2s1_data_d;
wire i2s2_data_d;
wire n67_6;
wire lrck_d_2;
wire pcm_data_d;
wire n6_7;
wire i2s1_data_out_d;
wire i2s2_data_out_d;
wire left_f;
wire left_f_19;
wire green_d;
wire blue_d;
wire red_d;
wire [0:0] bit_cnt;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  OBUF sclk_obuf (
    .O(sclk),
    .I(sclk_d) 
);
  OBUF lrck_obuf (
    .O(lrck),
    .I(lrck_d) 
);
  OBUF i2s1_data_obuf (
    .O(i2s1_data),
    .I(i2s1_data_d) 
);
  OBUF i2s2_data_obuf (
    .O(i2s2_data),
    .I(i2s2_data_d) 
);
  OBUF pcm_data_obuf (
    .O(pcm_data),
    .I(pcm_data_d) 
);
  OBUF i2s1_data_out_obuf (
    .O(i2s1_data_out),
    .I(i2s1_data_out_d) 
);
  OBUF i2s2_data_out_obuf (
    .O(i2s2_data_out),
    .I(i2s2_data_out_d) 
);
  OBUF red_obuf (
    .O(red),
    .I(red_d) 
);
  OBUF green_obuf (
    .O(green),
    .I(green_d) 
);
  OBUF blue_obuf (
    .O(blue),
    .I(blue_d) 
);
  i2s_generator i2s_gen (
    .clk_d(clk_d),
    .sclk_d(sclk_d),
    .lrck_d(lrck_d),
    .i2s1_data_d(i2s1_data_d),
    .i2s2_data_d(i2s2_data_d),
    .n67_6(n67_6)
);
  i2s_to_pcm i2s_mux (
    .sclk_d(sclk_d),
    .left_f_19(left_f_19),
    .lrck_d(lrck_d),
    .i2s1_data_d(i2s1_data_d),
    .i2s2_data_d(i2s2_data_d),
    .n67_6(n67_6),
    .left_f(left_f),
    .lrck_d_0(lrck_d_2),
    .pcm_data_d(pcm_data_d),
    .n6_7(n6_7),
    .bit_cnt(bit_cnt[0])
);
  pcm_to_i2s i2s_demux (
    .sclk_d(sclk_d),
    .pcm_data_d(pcm_data_d),
    .n67_6(n67_6),
    .n6_7(n6_7),
    .lrck_d(lrck_d),
    .lrck_d_1(lrck_d_2),
    .bit_cnt(bit_cnt[0]),
    .i2s1_data_out_d(i2s1_data_out_d),
    .i2s2_data_out_d(i2s2_data_out_d),
    .left_f(left_f),
    .left_f_19(left_f_19)
);
  rgb_blink rgb_blink (
    .clk_d(clk_d),
    .green_d(green_d),
    .blue_d(blue_d),
    .red_d(red_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top_module */
